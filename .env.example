# model — OpenRouter, no local model needed
OPENROUTER_API_KEY=sk-or-REPLACE
# free tool-calling options, all verified via GET /api/v1/models?supported_parameters=tools:
#   nvidia/nemotron-3.5-super-vl:free   1M ctx, fastest/most reliable in 3rd-party benchmarks
#   inclusionai/ling-3.2-flash:free     1M ctx, longest completion budget (262k)
#   cohere/north-mini-code:free         256K ctx, prompts not used for training
MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# optional app attribution shown on openrouter.ai rankings
APP_REFERER=https://github.com/tejasvi/pitu-calendar-agent
APP_TITLE=Pitu - Calendar Agent

# google — P1-P3 use login.py with a Desktop client; P4-P5 add the Web client
GOOGLE_CLIENT_ID=
GOOGLE_CREDENTIALS_PATH=

# local fallback timezone until Phase 4 takes X-Timezone from the client
DEFAULT_TZ=Asia/Singapore
